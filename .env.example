# Railyard local configuration. ./run.sh copies this to .env and fills in SESSION_SECRET.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4105
WEB_PORT=5105
APP_ORIGIN=http://localhost:5105

# Local PostgreSQL over the Unix socket in /tmp as the current OS user (no password).
# run.sh replaces __OS_USER__ with your user name.
DATABASE_URL=postgres://__OS_USER__@localhost/railyard_dev?host=/tmp
TEST_DATABASE_URL=postgres://__OS_USER__@localhost/railyard_test?host=/tmp
DATABASE_POOL_MAX=10

SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
LOG_LEVEL=info

# false (default), a hop count such as 1, or proxy IPs/CIDRs (e.g. 127.0.0.1). Required in production.
TRUST_PROXY=false

LOGIN_IP_RATE_LIMIT=50
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_EMAIL_FREE_ATTEMPTS=5
LOGIN_BACKOFF_BASE_SECONDS=30
LOGIN_BACKOFF_MAX_SECONDS=3600
LOGIN_MAX_EMAILS_PER_IP=20
RATE_LIMIT_MAX_KEYS=10000
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600

# Runner
WORKSPACE_ROOT=.workspaces
RUNNER_LEASE_SECONDS=30
RUNNER_POLL_MS=1000
RUNNER_KEEP_WORKSPACES=false
